{
  "title": "LLM Platform: vLLM throughput, latency, cost",
  "uid": "llm-platform",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Output tokens / sec",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llm:generation_tokens:rate5m"
        }
      ]
    },
    {
      "type": "stat",
      "title": "p95 time to first token",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llm:ttft_seconds:p95_5m"
        }
      ]
    },
    {
      "type": "stat",
      "title": "p95 end-to-end latency",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llm:e2e_latency_seconds:p95_5m"
        }
      ]
    },
    {
      "type": "stat",
      "title": "$ per 1M output tokens",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llm:usd_per_1m_output_tokens"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Token throughput",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llm:generation_tokens:rate5m",
          "legendFormat": "output"
        },
        {
          "refId": "B",
          "expr": "llm:prompt_tokens:rate5m",
          "legendFormat": "prompt"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency percentiles",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(vllm:e2e_request_latency_seconds_bucket[5m])))",
          "legendFormat": "e2e p50"
        },
        {
          "refId": "B",
          "expr": "llm:e2e_latency_seconds:p95_5m",
          "legendFormat": "e2e p95"
        },
        {
          "refId": "C",
          "expr": "llm:ttft_seconds:p95_5m",
          "legendFormat": "TTFT p95"
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:inter_token_latency_seconds_bucket[5m])))",
          "legendFormat": "inter-token p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests running / waiting",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(vllm:num_requests_running)",
          "legendFormat": "running"
        },
        {
          "refId": "B",
          "expr": "sum(vllm:num_requests_waiting)",
          "legendFormat": "waiting"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "KV cache usage",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(vllm:kv_cache_usage_perc)",
          "legendFormat": "kv cache"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GPU utilization (DCGM exporter, if installed)",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(DCGM_FI_DEV_GPU_UTIL)",
          "legendFormat": "gpu util %"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cost per 1M output tokens",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llm:usd_per_1m_output_tokens",
          "legendFormat": "$ / 1M tokens"
        }
      ]
    }
  ]
}